# RUSH 5OUR — environment variables. Names only; never put real values here.
#
# LOCAL: copy this file to `.env.local`, fill in the values, then restart
#        `npm run dev` — or rebuild (`npm run build`, then `npm start`).
# VERCEL: add the same names under Project → Settings → Environment
#        Variables, then REDEPLOY — a change there does not reach a
#        deployment that is already built.
#
# `.env.local` is git-ignored. Only NEXT_PUBLIC_ variables reach the
# browser; everything else stays on the server.

# --- Contact form + Join sign-up (SendGrid) --------------------------------
# API key with the "Mail Send" permission only. Starts with "SG.".
SENDGRID_API_KEY=
# The inbox that receives contact messages and sign-ups.
CONTACT_TO_EMAIL=
# A sender SendGrid has verified (Settings → Sender Authentication).
CONTACT_FROM_EMAIL=

# --- Hunt Map (Mapbox) ------------------------------------------------------
# A PUBLIC token (starts with "pk."), URL-restricted to the site's domains.
# Read at build time: rebuild after changing it.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Merch store (Shopify Storefront API) — server-side only -----------------
# The store's myshopify domain, e.g. rush5our.myshopify.com
SHOPIFY_STORE_DOMAIN=
# A Storefront API access token: Shopify admin → Sales channels → Headless
# → Storefront API → "Public access token" (or a custom app's Storefront
# token). Scopes: unauthenticated_read_product_listings,
# unauthenticated_write_checkouts, unauthenticated_read_checkouts.
SHOPIFY_STOREFRONT_TOKEN=
# Optional: the Storefront API version (default 2026-07).
# SHOPIFY_API_VERSION=
